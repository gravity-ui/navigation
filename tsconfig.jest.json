{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "build-jest",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react",
    "baseUrl": ".",
    "paths": {
      "~playwright/*": ["playwright/*"],
      "@gravity-ui/uikit/i18n": ["node_modules/@gravity-ui/uikit/build/cjs/i18n"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx"
  ]
}


